# ── Server ──────────────────────────────────────────────
# server.js uses PORT (default 4000). PaaS inject $PORT automatically.
PORT=4000

# ── Database (PostgreSQL + pgvector) ────────────────────
# DATABASE_URL takes precedence over the DB_* parts when set.
# Use the SAME database as the FastAPI backend (FYP_DB_Latest).
DATABASE_URL=postgresql://postgres:admin@localhost:5432/FYP_DB_Latest
DB_HOST=localhost
DB_PORT=5432
DB_NAME=FYP_DB_Latest
DB_USER=postgres
DB_PASSWORD=admin

# ── Service URLs ────────────────────────────────────────
# Where the FastAPI AI backend lives (used to proxy /api/agent calls).
FASTAPI_BASE_URL=http://localhost:8000
# Allowed CORS origin (the deployed frontend URL).
FRONTEND_URL=http://localhost:3000

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Mirror of the publishable key some code paths expect.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
