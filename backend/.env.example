# ── Database (PostgreSQL + pgvector) ────────────────────
# Use the SAME database as backend-express (FYP_DB_Latest).
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://postgres:admin@localhost:5432/FYP_DB_Latest

# ── Google Gemini (primary LLM + embeddings) ────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Quota controls (free tier = 20 generate calls/day).
# Keep these at 0 to spend the budget only on chat replies.
GEMINI_HISTORY_SUMMARY=0
GEMINI_PROFILE_EXTRACTION=0

# ── Optional: OpenAI (not required; Gemini is primary) ──
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── Optional: Hugging Face (embedding model fallback) ───
HUGGING_FACE_ACCESS_TOKEN=
REPO_NAME_FROM_HUGGING_FACE=prismalabs/text-embedding-3-small

# ── Server ──────────────────────────────────────────────
# PORT is injected by most PaaS (Render/Railway). Default 8000.
PORT=8000
